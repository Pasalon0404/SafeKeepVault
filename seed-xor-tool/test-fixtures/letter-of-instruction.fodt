<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:automatic-styles>
 <style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
 <style:style style:name="I" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
 <style:style style:name="U" style:family="text"><style:text-properties style:text-underline-style="solid"/></style:style>
 <style:style style:name="C" style:family="paragraph"><style:paragraph-properties fo:text-align="center"/></style:style>
 <text:list-style style:name="Num"><text:list-level-style-number text:level="1" style:num-format="1"/></text:list-style>
</office:automatic-styles>
<office:body><office:text>
<text:h text:outline-level="1">Letter of instruction</text:h>
<text:p>Dear family, the <text:span text:style-name="B">seed backup</text:span> is in the <text:span text:style-name="I">safe</text:span> and <text:span text:style-name="U">nowhere else</text:span>. Café ✓ &lt;b&gt;not markup&lt;/b&gt;<text:line-break/>Second line<text:tab/>after a tab and<text:s text:c="3"/>three spaces.</text:p>
<text:p text:style-name="C">A centered line</text:p>
<text:h text:outline-level="2">Steps</text:h>
<text:list text:style-name="Num"><text:list-item><text:p>Find the flash drive.</text:p></text:list-item><text:list-item><text:p>Boot SafeKeep.</text:p><text:list><text:list-item><text:p>Nested bullet</text:p></text:list-item></text:list></text:list-item></text:list>
<text:list><text:list-item><text:p>A bullet point</text:p></text:list-item></text:list>
<text:p>Contact <text:a xlink:type="simple" xlink:href="https://example.com/">our lawyer</text:a>.<text:note text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>A footnote.</text:p></text:note-body></text:note></text:p>
<table:table table:name="T"><table:table-column table:number-columns-repeated="2"/>
<table:table-row><table:table-cell><text:p>Account</text:p></table:table-cell><table:table-cell><text:p>Where</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell table:number-columns-spanned="2"><text:p>Spanned cell</text:p></table:table-cell><table:covered-table-cell/></table:table-row>
</table:table>
<text:p><draw:frame draw:name="img1" svg:width="3cm" svg:height="2cm"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAADwAAAAoCAIAAAAt2Q6oAAAAQklEQVR4nO3OUQkAIBBAMXNY27D+GsN3MFiArXv2OOv7QDpMWlo6QFpaOkBaWjpAWlo6QFpaOkBaWjpAWlo6YGT6AanFYmLGKZMCAAAAAElFTkSuQmCC</office:binary-data></draw:image></draw:frame></text:p>
<text:p>The end.</text:p>
</office:text></office:body></office:document>